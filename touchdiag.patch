diff --git a/BaseBin/touchlog/Makefile b/BaseBin/touchlog/Makefile
new file mode 100644
index 0000000..cb94dff
--- /dev/null
+++ b/BaseBin/touchlog/Makefile
@@ -0,0 +1,22 @@
+TARGET = touchlog
+CC = clang
+SDKROOT = $(shell xcrun --sdk iphoneos --show-sdk-path)
+CFLAGS = -std=c11 -Wall -Wextra -Werror -Wno-deprecated-declarations -isysroot $(SDKROOT) -arch arm64 -miphoneos-version-min=16.0 -I./src
+LDFLAGS = -framework CoreFoundation -framework IOKit
+
+sign: $(TARGET)
+	ldid -Cadhoc -Sentitlements.plist $(TARGET)
+
+$(TARGET): src/main.c src/record.h src/iokit_compat.h
+	$(CC) $(CFLAGS) src/main.c $(LDFLAGS) -o $@
+
+test:
+	@mkdir -p .build
+	clang -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined -I./src tests/record_test.c -o .build/record_test
+	.build/record_test
+
+clean:
+	rm -f $(TARGET)
+	rm -rf .build
+
+.PHONY: sign test clean
diff --git a/BaseBin/touchlog/README.md b/BaseBin/touchlog/README.md
new file mode 100644
index 0000000..cce2457
--- /dev/null
+++ b/BaseBin/touchlog/README.md
@@ -0,0 +1,47 @@
+# Touch driver diagnostic subscriber
+
+This helper captures existing driver diagnostic strings. It does not repair the
+screen, change report handling, or replace a userspace reboot.
+
+It is restricted to root on iPhone10,5 / build20H350 and exits successfully if the
+device, service, ABI, permissions, or output directory do not match expectations.
+There is no automatic retry. It runs at most600seconds, writes at most2MiB per
+invocation, and responds to SIGTERM/SIGINT. Output is a uniquely created0600 file
+owned by mobile under `/var/mobile/Media/DopamineTouchDiagnostics/` for AFC export.
+Each directory component is opened without following symbolic links and checked
+for its expected owner/type. No existing output file is overwritten.
+
+The validated 20H350 AppleInputDeviceSupport/AppleHIDTransportSPI ABI is:
+
+- Match `AppleHIDTransportDeviceSPI`; open type `0x4d544c47` (MTLG).
+- Map memory type16 with the normal writable consumer-head mapping.
+- Register notification port type16. No external method selectors are used.
+- Consume standard IOSharedDataQueue entries with mapped-memory bounds checks.
+- Accept record type1 (little-endian uint16 at0); header is16bytes; seconds and
+  microseconds are uint32 at4 and8, text length is uint16 at12, text begins at16.
+  Byte2 is a constant3, not a severity. Text need not end in NUL.
+- Persist only report-info and SPI-error strings. Skip binary transaction records
+  and other record types/strings; no touch-coordinate capture.
+
+The generic platform/no-container entitlements are included for the root helper.
+Static driver analysis found no logger-specific entitlement check; opening can
+still fail because of generic platform policy, and failure is recorded gracefully.
+The queue subscription itself allocates/registers a diagnostic consumer; it is
+read-only with respect to device reports, firmware and driver settings. Normal
+queue consumption advances the shared consumer head.
+
+ABI evidence: matching Apple firmware kernelcache SHA256
+`5a53d33dfb2d4edf6c1219ccc5d2cabf939071bc2908c18899fd446436b50258`.
+Full annotated static analysis is retained in the investigation's `logger-abi.md`.
+Standard queue APIs: Apple's IOKitUser `IODataQueueClient.h` and `.c`:
+https://github.com/apple-oss-distributions/IOKitUser
+
+SDKs without IOKit client headers use the declarations in `src/iokit_compat.h`.
+Signatures are pinned to Apple's IOKitUser commit
+`323ead896d04424f87184d8f6ff0cce811aab106` (APSL2.0); no queue implementation is
+vendored. The actual system IOKit functions implement mapping/dequeue. Both the
+native-header and fallback-declaration modes receive host syntax checks. CI must
+still establish iOS framework linkage.
+
+`make test` checks record parsing under ASan/UBSan. It performs no device calls.
+Host syntax/packaging tests cannot validate queue subscription on the phone.
