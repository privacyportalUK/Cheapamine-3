diff --git a/BaseBin/touchlog/src/iokit_compat.h b/BaseBin/touchlog/src/iokit_compat.h
new file mode 100644
index 0000000..66df998
--- /dev/null
+++ b/BaseBin/touchlog/src/iokit_compat.h
@@ -0,0 +1,59 @@
+#ifndef TOUCHLOG_IOKIT_COMPAT_H
+#define TOUCHLOG_IOKIT_COMPAT_H
+/* Minimal ABI declarations for iOS SDKs that omit IOKit client headers.
+ * Function signatures: Apple IOKitUser, commit
+ * 323ead896d04424f87184d8f6ff0cce811aab106, IOKitLib.h/IODataQueueClient.h.
+ * Queue layout matches Apple's IODataQueueShared.h (12-byte memory header,
+ * 4-byte entry header). Declarations only; no copied implementation.
+ * Apple source is distributed under APSL 2.0: https://opensource.apple.com/apsl/.
+ */
+#if !defined(TOUCHLOG_FORCE_COMPAT) && __has_include(<IOKit/IOKitLib.h>) && __has_include(<IOKit/IODataQueueClient.h>)
+#include <IOKit/IOKitLib.h>
+#include <IOKit/IODataQueueClient.h>
+#else
+#include <CoreFoundation/CoreFoundation.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <stdint.h>
+#include <stddef.h>
+typedef mach_port_t io_object_t;
+typedef io_object_t io_service_t;
+typedef io_object_t io_connect_t;
+typedef io_object_t io_iterator_t;
+typedef io_object_t io_registry_entry_t;
+typedef char io_name_t[128];
+typedef uint32_t IOOptionBits;
+typedef kern_return_t IOReturn;
+typedef struct { uint32_t size; unsigned char data[4]; } IODataQueueEntry;
+typedef struct {
+    uint32_t queueSize;
+    uint32_t head;
+    uint32_t tail;
+    IODataQueueEntry queue[1];
+} IODataQueueMemory;
+#define IO_OBJECT_NULL ((io_object_t)0)
+#define kIOMasterPortDefault ((mach_port_t)0)
+#define kIOReturnSuccess KERN_SUCCESS
+#define kIOMapAnywhere ((IOOptionBits)1)
+CFMutableDictionaryRef IOServiceMatching(const char *name);
+kern_return_t IOServiceGetMatchingServices(mach_port_t mainPort, CFDictionaryRef matching, io_iterator_t *existing);
+io_object_t IOIteratorNext(io_iterator_t iterator);
+kern_return_t IOObjectRelease(io_object_t object);
+kern_return_t IOObjectGetClass(io_object_t object, io_name_t className);
+kern_return_t IORegistryEntryGetName(io_registry_entry_t entry, io_name_t name);
+kern_return_t IORegistryEntryGetRegistryEntryID(io_registry_entry_t entry, uint64_t *entryID);
+kern_return_t IOServiceOpen(io_service_t service, task_port_t owningTask, uint32_t type, io_connect_t *connect);
+kern_return_t IOServiceClose(io_connect_t connect);
+kern_return_t IOConnectMapMemory64(io_connect_t connect, uint32_t memoryType, task_port_t intoTask,
+                                  mach_vm_address_t *atAddress, mach_vm_size_t *ofSize, IOOptionBits options);
+kern_return_t IOConnectUnmapMemory64(io_connect_t connect, uint32_t memoryType, task_port_t fromTask,
+                                    mach_vm_address_t atAddress);
+kern_return_t IOConnectSetNotificationPort(io_connect_t connect, uint32_t type, mach_port_t port, uintptr_t reference);
+Boolean IODataQueueDataAvailable(IODataQueueMemory *queue);
+IODataQueueEntry *IODataQueuePeek(IODataQueueMemory *queue);
+IOReturn IODataQueueDequeue(IODataQueueMemory *queue, void *data, uint32_t *dataSize);
+mach_port_t IODataQueueAllocateNotificationPort(void);
+_Static_assert(offsetof(IODataQueueMemory, queue) == 12, "IODataQueue header ABI");
+_Static_assert(offsetof(IODataQueueEntry, data) == 4, "IODataQueue entry ABI");
+#endif
+#endif
diff --git a/BaseBin/touchlog/src/main.c b/BaseBin/touchlog/src/main.c
new file mode 100644
index 0000000..94e5348
--- /dev/null
+++ b/BaseBin/touchlog/src/main.c
@@ -0,0 +1,239 @@
+/* Bounded diagnostic subscriber, not a touchscreen fix.
+ * ABI is restricted to iPhone10,5 / 20H350; see README.md.
+ * No external-method selectors, registry writes or firmware operations.
+ */
+#include "iokit_compat.h"
+#include <mach/mach.h>
+#include <sys/stat.h>
+#include <sys/sysctl.h>
+#include <sys/utsname.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include "record.h"
+
+#define LOGGER_OPEN_TYPE UINT32_C(0x4d544c47)
+#define LOGGER_QUEUE_TYPE 16
+#define MAX_SECONDS 600
+#define MAX_FILE_BYTES (2U * 1024U * 1024U)
+#define MAX_MAP_BYTES (16U * 1024U * 1024U)
+
+static volatile sig_atomic_t stopping;
+static void stop(int sig) { (void)sig; stopping = 1; }
+
+static double monotonic_seconds(void)
+{
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) return -1;
+    return (double)t.tv_sec + (double)t.tv_nsec / 1000000000.0;
+}
+
+static bool supported_device(void)
+{
+    struct utsname u;
+    char build[64] = {0};
+    size_t len = sizeof(build);
+    return geteuid() == 0 && uname(&u) == 0 &&
+        strcmp(u.machine, "iPhone10,5") == 0 &&
+        sysctlbyname("kern.osversion", build, &len, NULL, 0) == 0 &&
+        len > 0 && len <= sizeof(build) && build[sizeof(build) - 1] == 0 &&
+        strcmp(build, "20H350") == 0;
+}
+
+static bool directory_ok(int fd, uid_t owner)
+{
+    struct stat st;
+    return fstat(fd, &st) == 0 && S_ISDIR(st.st_mode) &&
+        st.st_uid == owner && !(st.st_mode & S_IWOTH);
+}
+
+/* Resolve each component through an anchored directory descriptor. In
+ * particular, never follow /var or a mobile-created diagnostics symlink. */
+static int open_output(void)
+{
+    int dir = open("/", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (dir < 0) return -1;
+    const char *parts[] = {"private", "var", "mobile", "Media"};
+    const uid_t owners[] = {0, 0, 501, 501};
+    for (size_t i = 0; i < sizeof(parts) / sizeof(parts[0]); i++) {
+        int next = openat(dir, parts[i], O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        close(dir);
+        if (next < 0) return -1;
+        dir = next;
+        if (!directory_ok(dir, owners[i])) { close(dir); return -1; }
+    }
+    const char *name = "DopamineTouchDiagnostics";
+    bool created = mkdirat(dir, name, 0700) == 0;
+    if (!created && errno != EEXIST) { close(dir); return -1; }
+    int output_dir = openat(dir, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    close(dir);
+    if (output_dir < 0) return -1;
+    if (created && (fchown(output_dir, 501, 501) != 0 || fchmod(output_dir, 0700) != 0)) {
+        close(output_dir); return -1;
+    }
+    if (!directory_ok(output_dir, 501)) { close(output_dir); return -1; }
+    char filename[100];
+    snprintf(filename, sizeof(filename), "touchlog-%lld-%ld.txt", (long long)time(NULL), (long)getpid());
+    int fd = openat(output_dir, filename, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    close(output_dir);
+    if (fd < 0) return -1;
+    struct stat st;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_nlink != 1 ||
+        fchmod(fd, 0600) != 0 || fchown(fd, 501, 501) != 0) {
+        close(fd); return -1;
+    }
+    return fd;
+}
+
+static bool capped_write(int fd, size_t *written, const char *s, size_t n)
+{
+    if (n > MAX_FILE_BYTES - *written) return false;
+    while (n) {
+        ssize_t r = write(fd, s, n);
+        if (r < 0 && errno == EINTR && !stopping) continue;
+        if (r <= 0) return false;
+        *written += (size_t)r;
+        s += r;
+        n -= (size_t)r;
+    }
+    return true;
+}
+
+static bool queue_valid(IODataQueueMemory *queue, size_t mapped, uint32_t capacity)
+{
+    size_t header = offsetof(IODataQueueMemory, queue);
+    /* Standard Peek/Dequeue may inspect a size word at the end sentinel. */
+    if (mapped < header + sizeof(uint32_t) || capacity < sizeof(uint32_t) ||
+        capacity > mapped - header - sizeof(uint32_t)) return false;
+    uint32_t current_capacity = __atomic_load_n(&queue->queueSize, __ATOMIC_ACQUIRE);
+    uint32_t head = __atomic_load_n(&queue->head, __ATOMIC_RELAXED);
+    uint32_t tail = __atomic_load_n(&queue->tail, __ATOMIC_ACQUIRE);
+    return current_capacity == capacity && head <= capacity && tail <= capacity;
+}
+
+int main(void)
+{
+    if (!supported_device()) return 0;
+    signal(SIGTERM, stop);
+    signal(SIGINT, stop);
+    signal(SIGPIPE, SIG_IGN);
+    double start = monotonic_seconds();
+    if (start < 0) return 0;
+    int fd = open_output();
+    if (fd < 0) return 0;
+    size_t written = 0;
+    char intro[240];
+    int intro_length = snprintf(intro, sizeof(intro), "touchlog diagnostic subscriber; iPhone10,5 / 20H350\nStarted at Unix seconds %lld\nFiltered report-info and SPI error text only. No raw touch records.\n", (long long)time(NULL));
+    if (intro_length > 0 && (size_t)intro_length < sizeof(intro))
+        (void)capped_write(fd, &written, intro, (size_t)intro_length);
+    io_service_t service = IO_OBJECT_NULL;
+    io_connect_t connection = IO_OBJECT_NULL;
+    mach_port_t port = MACH_PORT_NULL;
+    mach_vm_address_t address = 0;
+    mach_vm_size_t mapped = 0;
+    const char *reason = "service unavailable";
+    kern_return_t kr = KERN_SUCCESS;
+    CFMutableDictionaryRef matching = IOServiceMatching("AppleHIDTransportDeviceSPI");
+    if (!matching) goto cleanup;
+    io_iterator_t iterator = IO_OBJECT_NULL;
+    kr = IOServiceGetMatchingServices(kIOMasterPortDefault, matching, &iterator);
+    if (kr != KERN_SUCCESS) goto cleanup;
+    service = IOIteratorNext(iterator);
+    io_service_t another = IOIteratorNext(iterator);
+    IOObjectRelease(iterator);
+    if (another) {
+        IOObjectRelease(another);
+        reason = "multiple SPI devices; target is ambiguous";
+        goto cleanup;
+    }
+    if (!service) goto cleanup;
+    uint64_t registry_id = 0;
+    kr = IORegistryEntryGetRegistryEntryID(service, &registry_id);
+    if (kr != KERN_SUCCESS) { reason = "cannot identify SPI registry entry"; goto cleanup; }
+    io_name_t service_name = {0};
+    io_name_t service_class = {0};
+    if (IORegistryEntryGetName(service, service_name) != KERN_SUCCESS ||
+        IOObjectGetClass(service, service_class) != KERN_SUCCESS) {
+        reason = "cannot identify SPI service name/class"; goto cleanup;
+    }
+    service_name[sizeof(service_name) - 1] = 0;
+    service_class[sizeof(service_class) - 1] = 0;
+    char identifier[400];
+    int identifier_length = snprintf(identifier, sizeof(identifier), "SPI registry entry ID: 0x%" PRIx64 "; name=%s; class=%s\n", registry_id, service_name, service_class);
+    if (identifier_length <= 0 || (size_t)identifier_length >= sizeof(identifier) ||
+        !capped_write(fd, &written, identifier, (size_t)identifier_length)) goto cleanup;
+    reason = "logger open denied or unavailable";
+    kr = IOServiceOpen(service, mach_task_self(), LOGGER_OPEN_TYPE, &connection);
+    if (kr != KERN_SUCCESS) goto cleanup;
+    reason = "logger memory unavailable";
+    kr = IOConnectMapMemory64(connection, LOGGER_QUEUE_TYPE, mach_task_self(), &address, &mapped, kIOMapAnywhere);
+    if (kr != KERN_SUCCESS || !address) goto cleanup;
+    reason = "unexpected queue mapping";
+    if (mapped > MAX_MAP_BYTES || mapped < offsetof(IODataQueueMemory, queue) + 8) goto cleanup;
+    IODataQueueMemory *queue = (IODataQueueMemory *)(uintptr_t)address;
+    uint32_t capacity = __atomic_load_n(&queue->queueSize, __ATOMIC_ACQUIRE);
+    if (!queue_valid(queue, (size_t)mapped, capacity)) goto cleanup;
+    reason = "notification port unavailable";
+    port = IODataQueueAllocateNotificationPort();
+    if (port == MACH_PORT_NULL) goto cleanup;
+    kr = IOConnectSetNotificationPort(connection, LOGGER_QUEUE_TYPE, port, 0);
+    if (kr != KERN_SUCCESS) goto cleanup;
+    char ready[100];
+    int ready_length = snprintf(ready, sizeof(ready), "logger subscribed at Unix seconds %lld\n", (long long)time(NULL));
+    if (ready_length <= 0 || (size_t)ready_length >= sizeof(ready) ||
+        !capped_write(fd, &written, ready, (size_t)ready_length)) goto cleanup;
+    reason = "capture time limit or signal";
+    while (!stopping) {
+        double now = monotonic_seconds();
+        if (now < start || now - start >= MAX_SECONDS) break;
+        if (!queue_valid(queue, (size_t)mapped, capacity)) { reason = "invalid queue bounds"; break; }
+        if (IODataQueueDataAvailable(queue)) {
+            IODataQueueEntry *entry = IODataQueuePeek(queue);
+            uintptr_t begin = (uintptr_t)queue->queue;
+            uintptr_t p = (uintptr_t)entry;
+            if (!entry || p < begin || p - begin > capacity - sizeof(uint32_t)) {
+                reason = "invalid queue entry"; break;
+            }
+            uint32_t length = entry->size;
+            if (length > capacity - (p - begin) - sizeof(uint32_t)) {
+                reason = "invalid queue entry length"; break;
+            }
+            char line[TOUCHLOG_LINE_CAP];
+            size_t n = touchlog_format_record(entry->data, length, line, sizeof(line));
+            if (n && !capped_write(fd, &written, line, n)) { reason = "file limit or write failure"; break; }
+            kr = IODataQueueDequeue(queue, NULL, NULL);
+            if (kr != KERN_SUCCESS) { reason = "queue dequeue failed"; break; }
+            continue;
+        }
+        /* The standard wait helper has no timeout; use a bounded receive. */
+        union { mach_msg_header_t header; unsigned char bytes[1024]; } message = {0};
+        kr = mach_msg(&message.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0,
+                      sizeof(message), port, 250, MACH_PORT_NULL);
+        if (kr == MACH_MSG_SUCCESS) mach_msg_destroy(&message.header);
+        else if (kr != MACH_RCV_TIMED_OUT && kr != MACH_RCV_INTERRUPTED) {
+            reason = "notification receive failed"; break;
+        }
+    }
+cleanup:
+    if (connection && port != MACH_PORT_NULL)
+        (void)IOConnectSetNotificationPort(connection, LOGGER_QUEUE_TYPE, MACH_PORT_NULL, 0);
+    if (address) (void)IOConnectUnmapMemory64(connection, LOGGER_QUEUE_TYPE, mach_task_self(), address);
+    if (connection) (void)IOServiceClose(connection);
+    if (port != MACH_PORT_NULL) (void)mach_port_mod_refs(mach_task_self(), port, MACH_PORT_RIGHT_RECEIVE, -1);
+    if (service) IOObjectRelease(service);
+    char ending[180];
+    int n = snprintf(ending, sizeof(ending), "capture ended at Unix seconds %lld: %s (status 0x%08x)\n", (long long)time(NULL), reason, (unsigned)kr);
+    if (n > 0 && (size_t)n < sizeof(ending)) (void)capped_write(fd, &written, ending, (size_t)n);
+    (void)fsync(fd);
+    close(fd);
+    /* Diagnostic inability must not cause launchd retry loops or block boot. */
+    return 0;
+}
diff --git a/BaseBin/touchlog/src/record.h b/BaseBin/touchlog/src/record.h
new file mode 100644
index 0000000..d76e711
--- /dev/null
+++ b/BaseBin/touchlog/src/record.h
@@ -0,0 +1,58 @@
+#ifndef TOUCHLOG_RECORD_H
+#define TOUCHLOG_RECORD_H
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define TOUCHLOG_TEXT_CAP 2048
+#define TOUCHLOG_LINE_CAP (TOUCHLOG_TEXT_CAP + 64)
+
+static inline uint16_t touchlog_u16(const unsigned char *p)
+{
+    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+static inline uint32_t touchlog_u32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Only diagnostic strings related to report-info exchange or SPI errors.
+ * Other strings, contact coordinates and binary transaction records are dropped.
+ * No assumption that record text is NUL terminated (cached logs need not be).
+ */
+static inline size_t touchlog_format_record(const void *record, size_t length,
+                                           char *output, size_t output_cap)
+{
+    if (!record || !output || length < 16 || !output_cap) return 0;
+    const unsigned char *p = record;
+    if (touchlog_u16(p) != 1) return 0;
+    size_t text_length = touchlog_u16(p + 12);
+    if (!text_length || text_length > length - 16 || text_length > TOUCHLOG_TEXT_CAP) return 0;
+    char text[TOUCHLOG_TEXT_CAP + 1];
+    memcpy(text, p + 16, text_length);
+    /* Allow one terminal NUL, reject embedded NUL to avoid ambiguous output. */
+    if (text[text_length - 1] == 0) text_length--;
+    for (size_t i = 0; i < text_length; i++) {
+        unsigned char c = (unsigned char)text[i];
+        if (!c) return 0;
+        if (c < 32 || c > 126) text[i] = ' ';
+    }
+    text[text_length] = 0;
+    const char *const allowed[] = {
+        "Getting report info", "getReportInfo", "deviceGetReportInfo",
+        "Cannot get report info", "reportID", "transferring data",
+        "rxBuffer[0]", "SPI transfer", "SPI Error", "SPI error",
+        "corrupt packet checksum", "checkChecksum"
+    };
+    int keep = 0;
+    for (size_t i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++)
+        if (strstr(text, allowed[i])) { keep = 1; break; }
+    if (!keep) return 0;
+    uint32_t sec = touchlog_u32(p + 4), usec = touchlog_u32(p + 8);
+    if (usec >= 1000000) return 0;
+    int n = snprintf(output, output_cap, "%u.%06u %s\n", sec, usec, text);
+    return n > 0 && (size_t)n < output_cap ? (size_t)n : 0;
+}
+#endif
diff --git a/BaseBin/touchlog/tests/record_test.c b/BaseBin/touchlog/tests/record_test.c
new file mode 100644
index 0000000..722db90
--- /dev/null
+++ b/BaseBin/touchlog/tests/record_test.c
@@ -0,0 +1,49 @@
+#include "record.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static size_t make_record(unsigned char *p, const char *text, int trailing_nul)
+{
+    size_t n = strlen(text) + (size_t)trailing_nul;
+    memset(p, 0, 4096);
+    p[0] = 1; p[2] = 3;
+    p[4] = 123; p[8] = 42;
+    p[12] = n & 255; p[13] = (n >> 8) & 255;
+    memcpy(p + 16, text, n);
+    return n + 16;
+}
+
+int main(void)
+{
+    unsigned char p[4096]; char line[TOUCHLOG_LINE_CAP];
+    size_t n = make_record(p, "Getting report info for0x12", 0);
+    assert(touchlog_format_record(p, n, line, sizeof(line)) > 0);
+    assert(strcmp(line, "123.000042 Getting report info for0x12\n") == 0);
+    n = make_record(p, "ERROR!! status0xe00002bc transferring data", 1);
+    assert(touchlog_format_record(p, n, line, sizeof(line)) > 0);
+    assert(touchlog_format_record(p, n - 1, line, sizeof(line)) == 0);
+    assert(touchlog_format_record(p, n, line, 5) == 0);
+    p[0] = 2; assert(touchlog_format_record(p, n, line, sizeof(line)) == 0);
+    n = make_record(p, "checkChecksum: ERROR!! corrupt packet checksum == 0x1234. calculated == 0x5678", 0);
+    assert(touchlog_format_record(p, n, line, sizeof(line)) > 0);
+    n = make_record(p, "touch coordinate x=10 y=20", 0);
+    assert(touchlog_format_record(p, n, line, sizeof(line)) == 0);
+    n = make_record(p, "reportID0x33\nmessage", 0);
+    assert(touchlog_format_record(p, n, line, sizeof(line)) > 0);
+    assert(strstr(line, "0x33 message"));
+    p[18] = 0; assert(touchlog_format_record(p, n, line, sizeof(line)) == 0);
+    for (size_t len = 0; len < 16; len++) assert(touchlog_format_record(p, len, line, sizeof(line)) == 0);
+    n = make_record(p, "reportID0x33", 0);
+    p[12] = 255; p[13] = 255;
+    assert(touchlog_format_record(p, n, line, sizeof(line)) == 0);
+    /* Exercise arbitrary short/truncated/binary buffers under sanitizers. */
+    srand(1);
+    for (size_t i = 0; i < 50000; i++) {
+        size_t len = (size_t)rand() % sizeof(p);
+        for (size_t j = 0; j < len; j++) p[j] = (unsigned char)rand();
+        (void)touchlog_format_record(p, len, line, sizeof(line));
+    }
+    puts("touchlog record parsing tests passed");
+    return 0;
+}
diff --git a/TOUCH-DIAGNOSTIC.md b/TOUCH-DIAGNOSTIC.md
new file mode 100644
index 0000000..b63c112
--- /dev/null
+++ b/TOUCH-DIAGNOSTIC.md
@@ -0,0 +1,15 @@
+# Dopamine 3 touch diagnostic build 1
+
+This is an investigation build, not a touchscreen fix.
+
+Based on official Dopamine 3.0.10 commit 1a54e76d515ff5916b64e44d6afbb57d2bc89ee9. It retains the actual userspace reboot, launch daemon startup, update lifecycle and tweak injection. It does not include Cheapamine's selective restart.
+
+A bounded diagnostic helper subscribes to the existing Apple HID transport logging queue on iPhone10,5 / iOS build20H350. It records selected report-info and transport error text for at most ten minutes and2MiB per run. It issues no touch-firmware commands, configuration writes or kernel patches. Raw touch/binary records are discarded. Logs stay on the phone under /var/mobile/Media/DopamineTouchDiagnostics for local USB retrieval; nothing uploads them.
+
+The helper starts once at jailbreak launch-daemon startup; it does not keep itself alive after exit. A userspace reboot terminates the old collector and may start a new one. Early records can be missed, so connection timestamps and limits must be considered when reading the result.
+
+The phone may still lose touch. If that happens, leave USB attached long enough to retrieve the diagnostic files, then use the usual force restart. A real fix will require an evidence-backed patch and testing on this phone.
+
+The app's existing cleanup/reboot handshake uses numeric version comparison so3.0.10 is treated as newer than3.0.5. Failed spawns are not sent signals or waited on. Packaging version3.0.10-d1 fits the16-byte dyld UUID marker.
+
+IPA integrity and parser tests do not prove device startup, touch recovery or correct driver queue behaviour. No such claim is made.
diff --git a/scripts/build-touchdiag-ipa.sh b/scripts/build-touchdiag-ipa.sh
